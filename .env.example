# Base URL of a private or trusted Gotenberg 9 instance (LibreOffice PDF conversion).
# Example: http://localhost:3000 for local development, or your HTTPS service URL in deployment.
GOTENBERG_URL=

# Optional HTTP Basic Auth credentials. Set both if Gotenberg Basic Auth is enabled.
# Keep these server-only; never prefix them with NEXT_PUBLIC_.
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=
